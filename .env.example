# -----------------------------
# Saucin AI - shared settings
# -----------------------------
SERVER_NAME=Saucin RP
TZ=America/Phoenix
APPDATA_ROOT=/mnt/user/appdata/saucin-ai

# PostgreSQL
POSTGRES_DB=saucin_ai
POSTGRES_USER=saucin_ai
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://saucin_ai:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/saucin_ai

# Redis
REDIS_URL=redis://redis:6379

# API / Dashboard
API_PORT=3100
DASHBOARD_PORT=3000
DASHBOARD_API_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
API_INTERNAL_URL=http://api:3100
# Separate outbound collector credential. Generate with: openssl rand -hex 32
TXADMIN_COLLECTOR_TOKEN=CHANGE_ME_TO_A_RANDOM_TXADMIN_COLLECTOR_TOKEN

# Discord bot + OAuth
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Dashboard authentication
DASHBOARD_AUTH_REQUIRED=true
# Use the exact URL that staff use to open the dashboard. The Discord OAuth redirect is this + /api/auth/callback
# LAN test example: http://192.168.1.25:3000
# Production URL locked for Saucin RP:
DASHBOARD_PUBLIC_URL=https://ai.saucinrp.com
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Cloudflare Tunnel (optional profile; recommended for production remote access)
# Create the tunnel in Cloudflare, then paste its token here. Keep this secret.
CLOUDFLARE_TUNNEL_TOKEN=
# Comma-separated Discord IDs. Authorize a specific owner account and/or one or more staff roles.
DASHBOARD_ALLOWED_USER_IDS=
DASHBOARD_ALLOWED_ROLE_IDS=

# New Discord channels start safely in monitor-only mode.
# monitor | questions | issues | suggestions | full | ignored
DEFAULT_CHANNEL_MODE=monitor

# AI - optional at first. Without a key, monitoring still works but AI replies are disabled.
OPENAI_API_KEY=
AI_CLASSIFIER_MODEL=gpt-5.4-nano
AI_REPLY_MODEL=gpt-5.4-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_ENABLED=true
AI_REPLY_CONFIDENCE=0.78
